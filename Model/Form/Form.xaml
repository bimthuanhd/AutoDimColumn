<Window x:Class="Model.Form.Form"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Model.Form"
             mc:Ignorable="d" Title ="AutoDim Column" 
             Height="200" Width="300" Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox  Header="Setting" FontWeight="DemiBold" Padding="5" Margin="5" >
            <StackPanel Orientation="Horizontal">
                <Grid>
                    <StackPanel >
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="5"/>
                                <Setter Property="Width" Value="120"/>
                                <Setter Property="Height" Value="20"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                            </Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="Margin" Value="0,0,10,0"/>
                                <Setter Property="Width" Value="120"/>
                                <Setter Property="Height" Value="20"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                            <Style TargetType="CheckBox">
                                <Setter Property="Margin" Value="0,0,10,0"/>
                                <Setter Property="Width" Value="120"/>
                                <Setter Property="Height" Value="20"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </StackPanel.Resources>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Dimension Style:"/>
                            <ComboBox ItemsSource="{Binding InputVM.ItemSource_NameDimStyleVM }" SelectedItem="{Binding InputVM.Selected_NameDimStyleVM}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Total Dimension:"/>
                            <CheckBox IsChecked="{Binding InputVM.IsHaveTotalDimVM}" Content="" />
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10" Width="180">
            <Button Content="Run" Background="#FF004676" Padding="0 2 0 0"  Margin="5" Width="80" Click="Button_OkClick" Cursor="" FontFamily="Roboto" FontWeight="Bold" Foreground="#FFFFFEFE" BorderBrush="#FFE0CCCC" />
            <Button Content="Cancel" Padding="0 2 0 0" Margin="5" Width="80" Height="25" FontFamily="Roboto" FontWeight="Bold" Click="Button_CancelClick"/>

        </StackPanel>
    </Grid>
</Window>
